{
    "name": "sarah-cartmell-site",
    "private": true,
    "version": "0.0.0",
    "type": "module",
    "scripts": {
        "dev": "vite --host 0.0.0.0",
        "build": "tsc -b && vite build",
        "lint": "eslint . && knip",
        "preview": "vite preview",
        "format": "pnpm prettier --write ."
    },
    "dependencies": {
        "@emotion/css": "^11.13.5",
        "@swc/plugin-emotion": "^14.7.0",
        "knip": "^6.1.1",
        "react": "^19.2.4",
        "react-dom": "^19.2.4",
        "react-social-icons": "^6.25.0"
    },
    "devDependencies": {
        "@eslint/js": "^9.39.3",
        "@types/react": "^19.2.14",
        "@types/react-dom": "^19.2.3",
        "@vitejs/plugin-react-swc": "^4.2.3",
        "eslint": "^9.39.3",
        "eslint-plugin-react-hooks": "^7.0.1",
        "eslint-plugin-react-refresh": "^0.5.2",
        "globals": "^17.3.0",
        "husky": "^9.1.7",
        "prettier": "3.8.1",
        "pretty-quick": "^4.2.2",
        "typescript": "^5.9.3",
        "typescript-eslint": "^8.56.1",
        "vite": "^7.3.1"
    },
    "husky": {
        "hooks": {
